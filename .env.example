# ---------------------------------------------------------------------------
# Natives backend configuration
# Copy this file to `.env` and fill in real values. Never commit real secrets
# in this example file — put them only in `.env` (which is gitignored).
#
# No quotes around values: `docker run --env-file` does NOT strip quote
# characters the way python-dotenv does locally, so a quoted value like
# JWT_VERIFY_ISSUER="true" becomes the literal string `"true"` (quotes
# included) inside the container and fails to parse as a bool. Unquoted
# values work identically with both python-dotenv (local/uvicorn) and
# Docker's --env-file.
# ---------------------------------------------------------------------------

# App
APP_NAME=Natives API
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins. Use * for all (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# Use the direct connection string for Alembic migrations.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# From Supabase dashboard: Project Settings -> Database -> Connection string.
# Note: the default database name is `postgres` unless you created another.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Supabase — new-style API keys (Project Settings -> API Keys)
#   publishable key: sb_publishable_...  (safe for client apps)
#   secret key:      sb_secret_...       (server-only; never expose)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# JWT verification
# Supabase signs access tokens with asymmetric keys (ES256) exposed via JWKS,
# so the backend verifies against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# No shared secret is needed for ES256.
# For a legacy project still on the shared HS256 secret, set:
#   JWT_ALGORITHM=HS256  and  SUPABASE_JWT_SECRET=<your legacy secret>
# ---------------------------------------------------------------------------
JWT_ALGORITHM=ES256
JWT_AUDIENCE=authenticated
JWT_VERIFY_ISSUER=true
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Storage buckets (create these in Supabase Storage)
# ---------------------------------------------------------------------------
LISTING_IMAGES_BUCKET=listing-images
AVATARS_BUCKET=avatars

# ---------------------------------------------------------------------------
# Admin bootstrap: this email is promoted to role=admin by scripts/seed.py
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
